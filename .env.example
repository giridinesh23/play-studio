# Gmail SMTP — use an App Password (not your regular Gmail password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# The inbox that receives all contact form submissions
CONTACT_EMAIL=your@gmail.com

# Your production domain — used for sitemap generation
NEXT_PUBLIC_SITE_URL=https://playstudiobhutan.com
